---
import "../styles/global.css";

const { title, description, ogImage } = Astro.props;

// 绝对地址：canonical 和 og:url 必须是完整的 URL
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" as="image" href="/uploads/case-product.png" type="image/png" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23ffffff'/%3E%3Ccircle cx='16' cy='16' r='9' fill='none' stroke='%23ff7500' stroke-width='3'/%3E%3C/svg%3E"
    />
  </head>
  <body>
    <slot />

    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
